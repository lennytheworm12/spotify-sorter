{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tracks"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "stage5b1b-sol-batch-response-v1"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stable_track_id",
          "selection_status",
          "selected_video_id",
          "selection_rationale",
          "candidates"
        ],
        "properties": {
          "stable_track_id": {"type": "string"},
          "selection_status": {
            "enum": ["SELECTED", "NO_SAFE_CANDIDATE", "UNCERTAIN"]
          },
          "selected_video_id": {
            "type": ["string", "null"]
          },
          "selection_rationale": {"type": "string"},
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "video_id",
                "label",
                "recording_identity_reason",
                "source_quality_reason",
                "uncertainty_reason"
              ],
              "properties": {
                "video_id": {"type": "string"},
                "label": {
                  "enum": ["IDEAL", "ACCEPTABLE", "WRONG", "UNCERTAIN"]
                },
                "recording_identity_reason": {"type": "string"},
                "source_quality_reason": {"type": "string"},
                "uncertainty_reason": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
