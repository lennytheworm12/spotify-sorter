# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Address the HTTP server binds to. 0.0.0.0 accepts WSL/container forwarding;
# users wanting local-interface-only can set 127.0.0.1. This is the listener
# address only — the browser-facing URLs below stay on 127.0.0.1 because
# Spotify rejects `localhost` for local OAuth redirects.
HOST=0.0.0.0

# ── Databases ─────────────────────────────────────────────────────────────
# Local defaults matching backend/docker-compose.yml (MongoDB + Redis).
# Swap these for your own instances (e.g. MongoDB Atlas) if not using Docker.
MONGO_URI=mongodb://admin:password@localhost:27017/spotify?authSource=admin
REDIS_URI=redis://localhost:6379

# ── Spotify app (https://developer.spotify.com/dashboard) ─────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must exactly match the Redirect URI registered in your Spotify app.
# Spotify rejects `localhost` for local OAuth redirects, so the loopback
# runtime intentionally uses 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# ── Auth ──────────────────────────────────────────────────────────────────
# At least 32 characters. Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_with_at_least_32_random_characters
# Where the OAuth callback sends the browser after login; also the CORS origin.
FRONTEND_URL=http://127.0.0.1:5173

# ── Cookie controls (optional) ────────────────────────────────────────────
# Defaults: development -> SameSite=lax, Secure=false;
#           production  -> SameSite=none, Secure=true.
# SameSite=none requires Secure=true (HTTPS).
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=yourdomain.com
